rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: validate required fields on daily report writes
    function hasRequiredReportFields() {
      let data = request.resource.data;
      return data.keys().hasAll(['kitchenId', 'reportDate', 'mealTypeId', 'rawReportedQty'])
             && (data.kitchenId is int || data.kitchenId is number)
             && (data.rawReportedQty is int || data.rawReportedQty is number);
    }

    // Daily reports — suppliers write their own, ramtal/admin read all
    match /daily_reports/{reportId} {
      allow read: if true;
      allow create: if hasRequiredReportFields();
      allow update: if true;
      allow delete: if true;
    }

    // Monthly summaries — read by all roles, written by system workflows
    match /monthly_summaries/{summaryId} {
      allow read: if true;
      allow write: if true;
    }

    // App config (disabled kitchens, settings) — admin only writes
    match /app_config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
